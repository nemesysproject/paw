{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "biometric:allow-authenticate",
    "biometric:allow-status",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:default",
    "fs:default",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-appdata-write",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read",
    "fs:allow-appdata-read-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPCACHE"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "/data/user/0/com.zutm.app_mobile/media_cache"
        },
        {
          "path": "/data/user/0/com.zutm.app_mobile/media_cache/**"
        }
      ]
    }
  ]
}